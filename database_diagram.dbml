// ==========================================
// HỆ THỐNG QUẢN LÝ DƯỢC PHẨM & KHO - PHARMACARE
// Cách dùng: Mở https://dbdiagram.io và dán toàn bộ mã này vào khung bên trái
// ==========================================

Table users {
  id bigint [pk, increment]
  name varchar [not null]
  email varchar [unique, not null]
  phone varchar
  role varchar [default: 'pharmacist', note: 'admin | pharmacist | warehouse']
  status varchar [default: 'active', note: 'active | inactive']
  salary decimal(12,2) [default: 0]
  email_verified_at timestamp
  password varchar [not null]
  remember_token varchar
  created_at timestamp
  updated_at timestamp

  Note: 'Bảng quản lý nhân viên và tài khoản người dùng'
}

Table categories {
  id bigint [pk, increment]
  name varchar [not null]
  description text
  created_at timestamp
  updated_at timestamp

  Note: 'Bảng danh mục thuốc điều trị'
}

Table medicines {
  id bigint [pk, increment]
  name varchar [not null]
  code varchar [unique, not null]
  category_id bigint [not null]
  unit varchar [not null, note: 'Viên, Vỉ, Hộp, Chai, Tuýp,...']
  price decimal(12,2) [not null]
  stock int [not null, default: 0]
  expiry_date date [not null]
  description text
  created_at timestamp
  updated_at timestamp

  Note: 'Bảng thông tin thuốc và số lượng tồn kho'
}

Table warehouse_receipts {
  id bigint [pk, increment]
  code varchar [unique, not null]
  type varchar [not null, default: 'import', note: 'import (Nhập kho) | export (Xuất kho)']
  supplier varchar [note: 'Nhà cung cấp hoặc đơn vị nhận hàng']
  user_id bigint [not null]
  total_amount decimal(14,2) [default: 0]
  note text
  created_at timestamp
  updated_at timestamp

  Note: 'Bảng phiếu nhập / xuất kho dược phẩm'
}

Table warehouse_receipt_details {
  id bigint [pk, increment]
  warehouse_receipt_id bigint [not null]
  medicine_id bigint [not null]
  quantity int [not null]
  unit_price decimal(12,2) [not null]
  total_price decimal(14,2) [not null]
  created_at timestamp
  updated_at timestamp

  Note: 'Bảng chi tiết các mặt hàng trong phiếu kho'
}

Table invoices {
  id bigint [pk, increment]
  code varchar [unique, not null]
  customer_name varchar [not null, default: 'Khách lẻ']
  customer_phone varchar
  user_id bigint [not null]
  total_amount decimal(14,2) [default: 0]
  payment_method varchar [not null, default: 'cash', note: 'cash | transfer | card']
  status varchar [not null, default: 'paid', note: 'paid | cancelled']
  note text
  created_at timestamp
  updated_at timestamp

  Note: 'Bảng hóa đơn bán lẻ thuốc tại quầy'
}

Table invoice_details {
  id bigint [pk, increment]
  invoice_id bigint [not null]
  medicine_id bigint [not null]
  quantity int [not null]
  unit_price decimal(12,2) [not null]
  total_price decimal(14,2) [not null]
  created_at timestamp
  updated_at timestamp

  Note: 'Bảng chi tiết danh sách thuốc bán trong hóa đơn'
}

// ==========================================
// MỐI QUAN HỆ GIỮA CÁC BẢNG (RELATIONSHIPS)
// ==========================================

// 1. Một danh mục có nhiều thuốc (1 - N)
Ref: categories.id < medicines.category_id [delete: cascade]

// 2. Một nhân viên lập nhiều phiếu kho (1 - N)
Ref: users.id < warehouse_receipts.user_id [delete: cascade]

// 3. Một phiếu kho có nhiều dòng chi tiết mặt hàng (1 - N)
Ref: warehouse_receipts.id < warehouse_receipt_details.warehouse_receipt_id [delete: cascade]

// 4. Một loại thuốc xuất hiện trong nhiều phiếu kho (1 - N)
Ref: medicines.id < warehouse_receipt_details.medicine_id [delete: cascade]

// 5. Một nhân viên/dược sĩ lập nhiều hóa đơn bán lẻ (1 - N)
Ref: users.id < invoices.user_id [delete: cascade]

// 6. Một hóa đơn có nhiều dòng chi tiết thuốc bán (1 - N)
Ref: invoices.id < invoice_details.invoice_id [delete: cascade]

// 7. Một loại thuốc xuất hiện trong nhiều hóa đơn bán lẻ (1 - N)
Ref: medicines.id < invoice_details.medicine_id [delete: cascade]
